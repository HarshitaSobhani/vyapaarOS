# Used by docker-compose.yml for local development. Copy to .env (never commit .env).
# Per-service references: backend/.env.example and frontend/.env.example.

# Password for the seeded demo accounts (demo@vyapaaros.in, manager@vyapaaros.in, sales@vyapaaros.in)
DEMO_USER_PASSWORD=
# Token signing secret. Any long random string locally.
SECRET_KEY=
# AI provider: mock (default, no key needed) or openai
AI_PROVIDER=mock
OPENAI_API_KEY=
