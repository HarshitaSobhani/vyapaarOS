# Public base URL of the FastAPI backend (no trailing slash). Visible to the browser; never put secrets here.
# Local:      http://localhost:8000
# Production: https://api-production-4dd4f.up.railway.app
NEXT_PUBLIC_API_URL=

# Optional, server-side only: backend URL for server components/route handlers (defaults to NEXT_PUBLIC_API_URL).
API_URL=
