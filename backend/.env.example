# ---- Required ----
# Railway PostgreSQL provides this (postgres:// or postgresql:// both work; it is adapted for psycopg automatically).
# Local (docker compose db published on 5432): postgresql://vyapaaros:vyapaaros@localhost:5432/vyapaaros
DATABASE_URL=postgresql://vyapaaros:vyapaaros@localhost:5432/vyapaaros
# Signs login tokens. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated browser origins allowed to call this API (no trailing slash needed, no wildcard).
# Production example: http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---- Environment ----
# development | production. Production hides /docs and refuses to start with the default SECRET_KEY.
ENVIRONMENT=development

# ---- Demo account (used only by `python -m app.seed`) ----
DEMO_USER_EMAIL=demo@vyapaaros.in
DEMO_USER_PASSWORD=
# Token lifetime in minutes (default 720 = 12h)
JWT_EXPIRE_MINUTES=720

# ---- AI (optional; the app works fully with mock) ----
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Limits (optional) ----
MAX_UPLOAD_BYTES=2097152
MAX_IMPORT_ROWS=5000

# PORT is injected by Railway; do not set it there. Locally the app defaults to 8000.
